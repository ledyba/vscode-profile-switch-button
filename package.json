{
  "name": "profile-switch-button",
  "displayName": "Profile Switch Button",
  "description": "Switch your profile in few clicks!",
  "icon": "icon.png",
  "publisher": "ledyba",
  "author": "Kaede Fujisaki",
  "license": "MIT",
  "homepage": "https://github.com/ledyba/vscode-profile-switch-button",
  "repository": {
    "type": "git",
    "url": "https://github.com/ledyba/vscode-profile-switch-button.git"
  },
  "version": "1.0.5",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true,
      "description": ""
    }
  },
  "extensionKind": ["ui", "workspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "pack": "vsce package",
    "up": "npm-check-updates -u && npm install && npm dedupe && npm audit fix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.1",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.33.0",
    "npm-check-updates": "^18.0.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  }
}
